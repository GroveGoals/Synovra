model User {
  id String @id @default(uuid())

  username    String @unique
  displayName String

  email String @unique

  dateOfBirth           DateTime?
  birthdayEmailEnabled  Boolean  @default(true)
  lastBirthdayEmailYear Int?

  usernameChangedAt    DateTime?
  displayNameChangedAt DateTime?

  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)
  lastSeenAt   DateTime?

  avatarDataUrl String? @db.Text
  country       String?
  language      String   @default("English")
  isPublic      Boolean  @default(true)

  verificationCode    String?
  verificationExpires DateTime?
  resetCode           String?
  resetExpires        DateTime?
  lastCodeSentAt      DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  toolRuns ToolRun[]
  collections Collection[]
  ownedCommunities Community[]
  posts Post[]
  comments Comment[]
  notifications Notification[]
  hostedEvents Event[]
  modActions ModerationAction[] @relation("ModActionModerator")
}