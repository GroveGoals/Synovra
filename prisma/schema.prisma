// Synovra V1 — Phase 1 (auth) + Phase 2 (profile + nav) schema.
// TODO(Phase 3+): AdminAction models get added in later phases.
// Do not add them yet — keeping this file scoped to what's actually built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique

  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)
  lastSeenAt   DateTime?

  avatarDataUrl String?  @db.Text
  country       String?
  language      String   @default("English")
  isPublic      Boolean  @default(true)

  verificationCode    String?
  verificationExpires DateTime?

  resetCode    String?
  resetExpires DateTime?

  lastCodeSentAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  toolRuns      ToolRun[]
  collections   Collection[]
  ownedCommunities Community[]
  posts            Post[]
  comments         Comment[]
  notifications    Notification[]
}

model Conversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  messages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolId       String
  toolLabel    String
  inputSummary String
  result       String  @db.Text
  favorited    Boolean @default(false)

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Collection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime  @default(now())
  toolRuns  ToolRun[]
}

model Community {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  iconDataUrl String? @db.Text
  bannerDataUrl String? @db.Text

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  memberIds String[] @default([])
  adminIds  String[] @default([])

  createdAt DateTime @default(now())
  posts     Post[]
  channels  Channel[]
}

model Channel {
  id          String  @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content  String   @db.Text
  likedBy  String[] @default([])

  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category    String
  title       String
  description String
  read        Boolean @default(false)

  createdAt DateTime @default(now())
}