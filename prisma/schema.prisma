// Synovra V1 — Phase 1 (auth) + Phase 2 (profile + nav) schema.
// TODO(Phase 3+): Community, Post, Notification, AdminAction models
// get added in later phases.
// Do not add them yet — keeping this file scoped to what's actually built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique

  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)
  lastSeenAt   DateTime?

  // Profile (Phase 2). Avatar is stored as a base64 data URL directly in
  // Postgres rather than a cloud storage bucket (S3/Cloudinary/etc.) — that
  // would need yet another third-party account. This works and persists
  // real images end to end; TODO(scale): move to real object storage once
  // traffic/avatar size makes that worth the extra account.
  avatarDataUrl String?  @db.Text
  country       String?
  language      String   @default("English")
  isPublic      Boolean  @default(true)

  // Email verification (code-based, real email sent via Resend)
  verificationCode    String?
  verificationExpires DateTime?

  // Forgot / reset password
  resetCode    String?
  resetExpires DateTime?

  // Shared cooldown for both verification + reset codes, so a user
  // can't spam the "resend" button and burn through email sends.
  lastCodeSentAt DateTime?

  // Basic brute-force protection on login (V1 spec: "Rate Limiting")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  toolRuns      ToolRun[]
  collections   Collection[]
}

model Conversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  messages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ToolRun {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolId       String
  toolLabel    String
  inputSummary String
  result       String  @db.Text
  favorited    Boolean @default(false)

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Collection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime  @default(now())
  toolRuns  ToolRun[]
}