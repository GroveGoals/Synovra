# Copy this file to .env for local development.
# In Render, these go in your Web Service's "Environment" tab instead —
# see README.md for the exact steps.

# From Neon: your project's connection string (use the "pooled connection" one)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# From Resend (https://resend.com) — free tier, used to send real
# verification + password reset emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender address for outgoing emails. While testing on Resend's free/sandbox
# tier, you can only send to the email address you signed up with, using
# their shared test sender "onboarding@resend.dev". To email real users,
# verify your own domain in Resend and use an address on it instead.
EMAIL_FROM="Synovra <onboarding@resend.dev>"

# Any long random string — used to sign session cookies (JWT).
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
