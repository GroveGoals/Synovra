// Synovra V1 — Phase 1 schema (auth only).
// TODO(Phase 2+): Community, Post, Notification, Favorite, HistoryItem,
// Collection, Session-log, AdminAction models get added in later phases.
// Do not add them yet — keeping this file scoped to what's actually built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  email    String @unique

  passwordHash String
  verified     Boolean @default(false)
  online       Boolean @default(false)

  // Email verification (code-based, real email sent via Resend)
  verificationCode    String?
  verificationExpires DateTime?

  // Forgot / reset password
  resetCode    String?
  resetExpires DateTime?

  // Shared cooldown for both verification + reset codes, so a user
  // can't spam the "resend" button and burn through email sends.
  lastCodeSentAt DateTime?

  // Basic brute-force protection on login (V1 spec: "Rate Limiting")
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
